<?xml version="1.0" encoding="utf-8"?>
<!-- Android blocks plain http by default. Allow it only for local/dev hosts.
     Add your PC's LAN IP below if you test on a real phone.
     For a public server, use https and remove this exception. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- <domain includeSubdomains="false">192.168.1.50</domain> -->
    </domain-config>
</network-security-config>
